# Contact form (https://resend.com). Without a key the form tells visitors to email you directly.
RESEND_API_KEY=
# Where messages are delivered (defaults to the email in src/content/site.ts)
CONTACT_TO_EMAIL=
# Must be on a domain verified in Resend. The default only delivers to your own Resend account email.
CONTACT_FROM_EMAIL="Portfolio <onboarding@resend.dev>"

# Public address of the site, used for RSS, the sitemap and social cards (e.g. https://sennerd.com).
# Leave empty to use https://sennerd.com.
NEXT_PUBLIC_SITE_URL=
